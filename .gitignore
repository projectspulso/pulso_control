# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode (nao versionar)
__pycache__/
*.pyc

# sessao gravada para a captura dos Bastidores — CREDENCIAL, nunca versionar
scripts/capturas/.sessao.json

# capturas dos Bastidores: o repo e PUBLICO e `public/` e servido sem login.
# A crua do Decisor nunca pode viajar. O indice (.md) continua versionado.
public/pulso/bastidores_capturas/*.png
public/pulso/bastidores_capturas/*.mp4

# rosto do dono (kit dos Bastidores). O repo e PUBLICO e `public/` e servido sem login:
# os 23 quadros respondiam 200 a qualquer visitante. Moram no OneDrive.
public/pulso/avatar_dono/
